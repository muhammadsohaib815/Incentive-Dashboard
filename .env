# .env file
# PostgreSQL application pool (values apply per API worker process)
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=60000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DB_KEEPALIVES_IDLE_SECONDS=30
DB_KEEPALIVES_INTERVAL_SECONDS=10
DB_KEEPALIVES_COUNT=5

DB_HOST=localhost            # Database server IP or hostname (e.g. localhost or remote server)
DB_PORT=1234                # Default PostgreSQL port is 5432
DB_NAME=ai-sales-intelligence-platform-db           # Name of your PostgreSQL database
DB_USER=postgres             # PostgreSQL username
DB_PASSWORD=sohaib   # PostgreSQL password
